<Window x:Class="DesktopRug.App.Windows.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:rendering="clr-namespace:DesktopRug.App.Rendering" Title="Desktop Rug · Settings" Width="610" Height="800" MinWidth="500" MinHeight="500" WindowStartupLocation="CenterScreen" Style="{StaticResource {x:Type Window}}">
  <Grid Margin="26,22" Background="#171C20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,18">
      <TextBlock Text="DESKTOP RUG" Foreground="#D5B277" FontSize="11" FontWeight="SemiBold"/>
      <TextBlock Text="A softer desktop." FontSize="28" FontWeight="SemiBold" Margin="0,4,0,5"/>
      <TextBlock Text="A little woven calm. Your files stay exactly where they are." Foreground="#A9B0B2" TextWrapping="Wrap"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
      <StackPanel>
        <Border Background="#222A2D" CornerRadius="10" Height="195" Margin="0,0,0,16"><rendering:SkiaCanvas x:Name="Preview"/></Border>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="Weave &amp; pattern"/><ComboBox x:Name="Pattern" SelectionChanged="PatternChanged"/><Button Content="Choose a local image…" Click="ChooseImage" HorizontalAlignment="Left"/><TextBlock x:Name="ImageName" TextTrimming="CharacterEllipsis" Foreground="#A9B0B2" FontSize="12" Margin="0,6,0,12"/></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="Rug size"/><ComboBox x:Name="SizeChoice"/><TextBlock Text="Simulation"/><ComboBox x:Name="Quality"/></StackPanel>
        </Grid>
        <Grid Margin="0,4,0,10">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="Rotation"/><Slider x:Name="Rotation" Minimum="-180" Maximum="180" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,9"/><TextBlock Text="Soft shadow"/><Slider x:Name="Shadow" Minimum="0" Maximum="1" Margin="0,9"/></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="Weave detail"/><Slider x:Name="Detail" Minimum="0" Maximum="1" Margin="0,9"/><TextBlock Text="Surface lighting"/><Slider x:Name="Lighting" Minimum="0" Maximum="1" Margin="0,9"/></StackPanel>
        </Grid>
        <TextBlock Text="Display"/><ComboBox x:Name="Monitor" DisplayMemberPath="DeviceName"/>
        <CheckBox x:Name="Bumps" Content="Let real desktop icons gently lift the fabric"/>
        <CheckBox x:Name="Sound" Content="Quiet fabric sounds"/>
        <CheckBox x:Name="Startup" Content="Launch at Windows sign-in"/>
        <DockPanel Margin="0,10"><TextBlock Text="Peek duration" VerticalAlignment="Center"/><ComboBox x:Name="PeekDuration" Width="100" Margin="14,0,0,0" HorizontalAlignment="Left"/></DockPanel>
        <Border Background="#222A2D" CornerRadius="8" Padding="14" Margin="0,10,0,12">
          <StackPanel>
            <TextBlock Text="Make yourself at home" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBlock Text="Drag the middle to move. Pull a corner to lift and fold. Right-click to peek. Scroll to rotate. Double-click for a compact strip." TextWrapping="Wrap" Foreground="#B9C1C2"/>
            <TextBlock x:Name="Shortcuts" TextWrapping="Wrap" Foreground="#D5B277" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>
        <TextBlock x:Name="Diagnostics" TextWrapping="Wrap" Foreground="#A9B0B2" Margin="0,0,0,12"/>
        <TextBlock Text="The rug appears when the desktop has focus. It rests while you work in another app. One rug, on one display at a time." TextWrapping="Wrap" Foreground="#A9B0B2" Margin="0,0,0,12"/>
      </StackPanel>
    </ScrollViewer>
    <Grid Grid.Row="2" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button Content="Hide rug" Click="HideRug" HorizontalAlignment="Left" Background="#303A3D" Foreground="#F0E8DD"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Cancel" Click="Cancel" Background="#303A3D" Foreground="#F0E8DD"/><Button x:Name="ApplyButton" Content="Save changes" Click="Apply" Margin="0"/></StackPanel>
    </Grid>
  </Grid>
</Window>
