<Window x:Class="DesktopRug.App.Windows.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:rendering="clr-namespace:DesktopRug.App.Rendering" Title="Desktop Rug · Settings" Width="610" Height="800" MinWidth="500" MinHeight="500" WindowStartupLocation="CenterScreen" Style="{StaticResource {x:Type Window}}">
  <Grid x:Name="SettingsPanel" Margin="26,22" Background="#171C20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,18">
      <TextBlock Text="DESKTOP RUG" Foreground="#D5B277" FontSize="11" FontWeight="SemiBold"/>
      <TextBlock Text="A softer desktop." FontSize="28" FontWeight="SemiBold" Margin="0,4,0,5"/>
      <TextBlock Text="A little woven calm. Your files stay exactly where they are." Foreground="#A9B0B2" TextWrapping="Wrap"/>
    </StackPanel>
    <ScrollViewer x:Name="PreferencesScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
      <StackPanel>
        <Border Background="#222A2D" CornerRadius="10" Height="195" Margin="0,0,0,16"><rendering:SkiaCanvas x:Name="Preview"/></Border>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="Weave &amp; pattern"/><ComboBox x:Name="Pattern" SelectionChanged="PatternChanged" AutomationProperties.Name="Weave and pattern"/><Button Content="Choose a local image…" Click="ChooseImage" HorizontalAlignment="Left"/><TextBlock x:Name="ImageName" TextTrimming="CharacterEllipsis" Foreground="#A9B0B2" FontSize="12" Margin="0,6,0,12"/></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="Rug size"/><ComboBox x:Name="SizeChoice" AutomationProperties.Name="Rug size"/><TextBlock Text="Simulation"/><ComboBox x:Name="Quality" AutomationProperties.Name="Simulation quality"/></StackPanel>
        </Grid>
        <DockPanel Margin="0,0,0,12">
          <TextBlock Text="Size adjustment" VerticalAlignment="Center" Margin="0,0,12,0"/>
          <TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=RugScale, StringFormat={}{0:P0}}" Width="48" TextAlignment="Right" VerticalAlignment="Center"/>
          <Slider x:Name="RugScale" Minimum="0.25" Maximum="3" SmallChange="0.05" LargeChange="0.25" AutomationProperties.Name="Rug size adjustment" VerticalAlignment="Center"/>
        </DockPanel>
        <Grid Margin="0,4,0,10">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="Rotation"/><Slider x:Name="Rotation" Minimum="-180" Maximum="180" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,9" AutomationProperties.Name="Rotation in degrees"/><TextBlock Text="Soft shadow"/><Slider x:Name="Shadow" Minimum="0" Maximum="1" Margin="0,9" AutomationProperties.Name="Soft shadow"/></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="Weave detail"/><Slider x:Name="Detail" Minimum="0" Maximum="1" Margin="0,9" AutomationProperties.Name="Weave detail"/><TextBlock Text="Surface lighting"/><Slider x:Name="Lighting" Minimum="0" Maximum="1" Margin="0,9" AutomationProperties.Name="Surface lighting"/></StackPanel>
        </Grid>
        <TextBlock Text="Display"/><ComboBox x:Name="Monitor" DisplayMemberPath="DeviceName" AutomationProperties.Name="Display"/>
        <CheckBox x:Name="Bumps" Content="Let real desktop icons gently lift the fabric"/>
        <CheckBox x:Name="Sound" Content="Quiet fabric sounds"/>
        <CheckBox x:Name="Startup" Content="Launch at Windows sign-in"/>
        <Border Background="#222A2D" CornerRadius="8" Padding="14" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Text="Peek at your desktop icons" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition Width="115"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="Activation"/><ComboBox x:Name="PeekMode" DisplayMemberPath="Label" SelectedValuePath="Mode" SelectionChanged="PeekModeChanged" AutomationProperties.Name="Peek activation mode"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="Duration"/><ComboBox x:Name="PeekDuration" DisplayMemberPath="Label" SelectedValuePath="Seconds" AutomationProperties.Name="Peek duration"/></StackPanel>
            </Grid>
            <TextBlock Text="Keyboard shortcut"/>
            <WrapPanel VerticalAlignment="Center">
              <CheckBox x:Name="PeekControl" Content="Ctrl" Margin="0,8,16,8" AutomationProperties.Name="Include Ctrl in Peek shortcut"/>
              <CheckBox x:Name="PeekAlt" Content="Alt" Margin="0,8,16,8" AutomationProperties.Name="Include Alt in Peek shortcut"/>
              <CheckBox x:Name="PeekShift" Content="Shift" Margin="0,8,16,8" AutomationProperties.Name="Include Shift in Peek shortcut"/>
              <ComboBox x:Name="PeekKey" Width="86" Margin="0,2,0,4" IsEditable="True" AutomationProperties.Name="Peek shortcut key"/>
            </WrapPanel>
            <CheckBox x:Name="PeekRightClick" Content="Right-click the rug to Peek"/>
            <TextBlock x:Name="PeekHelp" TextWrapping="Wrap" Foreground="#B9C1C2" FontSize="12"/>
            <TextBlock Text="Use Ctrl or Alt, with an optional Shift. Emergency hide and show / hide shortcuts stay fixed." TextWrapping="Wrap" Foreground="#B9C1C2" FontSize="12" Margin="0,6,0,0"/>
          </StackPanel>
        </Border>
        <Border Background="#222A2D" CornerRadius="8" Padding="14" Margin="0,10,0,12">
          <StackPanel>
            <TextBlock Text="Make yourself at home" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBlock Text="Drag the middle to move across displays. Pull a corner to lift and fold. Scroll to rotate. Double-click to roll or unroll." TextWrapping="Wrap" Foreground="#B9C1C2"/>
            <TextBlock x:Name="Shortcuts" TextWrapping="Wrap" Foreground="#D5B277" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>
        <TextBlock x:Name="Diagnostics" TextWrapping="Wrap" Foreground="#A9B0B2" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,12"/>
        <TextBlock Text="The rug stays on the desktop beneath your application windows. It sleeps when the fabric settles." TextWrapping="Wrap" Foreground="#A9B0B2" Margin="0,0,0,12"/>
      </StackPanel>
    </ScrollViewer>
    <Grid Grid.Row="2" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock x:Name="SaveError" Grid.ColumnSpan="2" TextWrapping="Wrap" Foreground="#FFBC9A" AutomationProperties.LiveSetting="Assertive" Margin="0,0,0,8"/>
      <Button Grid.Row="1" Content="Hide rug" Click="HideRug" HorizontalAlignment="Left" Background="#303A3D" Foreground="#F0E8DD"/>
      <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal"><ProgressBar x:Name="SaveProgress" Width="28" Height="4" IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,12,0" AutomationProperties.Name="Saving settings"/><Button Content="Cancel" Click="Cancel" Background="#303A3D" Foreground="#F0E8DD"/><Button x:Name="ApplyButton" Content="Save changes" Click="Apply" Margin="0"/></StackPanel>
    </Grid>
  </Grid>
</Window>
