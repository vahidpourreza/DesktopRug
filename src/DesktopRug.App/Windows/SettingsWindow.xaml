<Window x:Class="DesktopRug.App.Windows.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:rendering="clr-namespace:DesktopRug.App.Rendering" Title="{DynamicResource T.Title}" Width="610" Height="800" MinWidth="500" MinHeight="500" WindowStartupLocation="CenterScreen" Style="{StaticResource {x:Type Window}}">
  <Grid x:Name="SettingsPanel" Margin="26,22" Background="#171C20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,18">
      <TextBlock Text="{DynamicResource T.Brand}" Foreground="#D5B277" FontSize="11" FontWeight="SemiBold"/>
      <TextBlock Text="{DynamicResource T.Heading}" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,5"/>
      <TextBlock Text="{DynamicResource T.Description}" Foreground="#A9B0B2" TextWrapping="Wrap"/>
    </StackPanel>
    <ScrollViewer x:Name="PreferencesScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
      <StackPanel>
        <Grid Margin="0,0,0,14">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center"><TextBlock Text="{DynamicResource T.Language}"/><TextBlock Text="{DynamicResource T.LanguageHelp}" TextWrapping="Wrap" Foreground="#A9B0B2" FontSize="12" Margin="0,4,10,0"/></StackPanel>
          <ComboBox x:Name="LanguageChoice" Grid.Column="1" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="LanguageChanged" AutomationProperties.Name="{DynamicResource T.LanguageAccessible}" Margin="0" VerticalAlignment="Center"/>
        </Grid>
        <Border Background="#222A2D" CornerRadius="10" Height="195" Margin="0,0,0,16"><rendering:SkiaCanvas x:Name="Preview" FlowDirection="LeftToRight"/></Border>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="{DynamicResource T.Pattern}"/><ComboBox x:Name="Pattern" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="PatternChanged" AutomationProperties.Name="{DynamicResource T.PatternAccessible}"/><Button Content="{DynamicResource T.ChooseImage}" Click="ChooseImage" HorizontalAlignment="Left"/><TextBlock x:Name="ImageName" FlowDirection="LeftToRight" TextTrimming="CharacterEllipsis" Foreground="#A9B0B2" FontSize="12" Margin="0,6,0,12"/></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource T.Size}"/><ComboBox x:Name="SizeChoice" DisplayMemberPath="Label" SelectedValuePath="Value" AutomationProperties.Name="{DynamicResource T.Size}"/><TextBlock Text="{DynamicResource T.Simulation}"/><ComboBox x:Name="Quality" DisplayMemberPath="Label" SelectedValuePath="Value" AutomationProperties.Name="{DynamicResource T.QualityAccessible}"/></StackPanel>
        </Grid>
        <DockPanel Margin="0,0,0,12">
          <TextBlock Text="{DynamicResource T.Scale}" VerticalAlignment="Center" Margin="0,0,12,0"/>
          <TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=RugScale, StringFormat={}{0:P0}}" FlowDirection="LeftToRight" Width="56" TextAlignment="Right" VerticalAlignment="Center"/>
          <Slider x:Name="RugScale" Minimum="0.25" Maximum="3" SmallChange="0.05" LargeChange="0.25" AutomationProperties.Name="{DynamicResource T.ScaleAccessible}" VerticalAlignment="Center"/>
        </DockPanel>
        <Grid Margin="0,4,0,10">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="{DynamicResource T.Rotation}"/><Slider x:Name="Rotation" Minimum="-180" Maximum="180" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,9" AutomationProperties.Name="{DynamicResource T.RotationAccessible}"/><TextBlock Text="{DynamicResource T.Shadow}"/><Slider x:Name="Shadow" Minimum="0" Maximum="1" Margin="0,9" AutomationProperties.Name="{DynamicResource T.Shadow}"/></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource T.Detail}"/><Slider x:Name="Detail" Minimum="0" Maximum="1" Margin="0,9" AutomationProperties.Name="{DynamicResource T.Detail}"/><TextBlock Text="{DynamicResource T.Lighting}"/><Slider x:Name="Lighting" Minimum="0" Maximum="1" Margin="0,9" AutomationProperties.Name="{DynamicResource T.Lighting}"/></StackPanel>
        </Grid>
        <TextBlock Text="{DynamicResource T.Display}"/><ComboBox x:Name="Monitor" DisplayMemberPath="DeviceName" FlowDirection="LeftToRight" AutomationProperties.Name="{DynamicResource T.Display}"/>
        <CheckBox x:Name="Bumps" Content="{DynamicResource T.Bumps}"/>
        <CheckBox x:Name="Sound" Content="{DynamicResource T.Sound}"/>
        <CheckBox x:Name="Startup" Content="{DynamicResource T.Startup}"/>
        <Border Background="#222A2D" CornerRadius="8" Padding="14" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Text="{DynamicResource T.PeekHeading}" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition Width="115"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="{DynamicResource T.Activation}"/><ComboBox x:Name="PeekMode" DisplayMemberPath="Label" SelectedValuePath="Mode" SelectionChanged="PeekModeChanged" AutomationProperties.Name="{DynamicResource T.PeekModeAccessible}"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource T.Duration}"/><ComboBox x:Name="PeekDuration" DisplayMemberPath="Label" SelectedValuePath="Seconds" AutomationProperties.Name="{DynamicResource T.PeekDurationAccessible}"/></StackPanel>
            </Grid>
            <TextBlock Text="{DynamicResource T.Shortcut}"/>
            <WrapPanel FlowDirection="LeftToRight" VerticalAlignment="Center">
              <CheckBox x:Name="PeekControl" Content="Ctrl" Margin="0,8,16,8" AutomationProperties.Name="{DynamicResource T.CtrlAccessible}"/>
              <CheckBox x:Name="PeekAlt" Content="Alt" Margin="0,8,16,8" AutomationProperties.Name="{DynamicResource T.AltAccessible}"/>
              <CheckBox x:Name="PeekShift" Content="Shift" Margin="0,8,16,8" AutomationProperties.Name="{DynamicResource T.ShiftAccessible}"/>
              <ComboBox x:Name="PeekKey" FlowDirection="LeftToRight" Width="86" Margin="0,2,0,4" IsEditable="True" AutomationProperties.Name="{DynamicResource T.PeekKeyAccessible}"/>
            </WrapPanel>
            <CheckBox x:Name="PeekRightClick" Content="{DynamicResource T.RightClick}"/>
            <TextBlock x:Name="PeekHelp" TextWrapping="Wrap" Foreground="#B9C1C2" FontSize="12"/>
            <TextBlock Text="{DynamicResource T.ShortcutHelp}" TextWrapping="Wrap" Foreground="#B9C1C2" FontSize="12" Margin="0,6,0,0"/>
          </StackPanel>
        </Border>
        <Border Background="#222A2D" CornerRadius="8" Padding="14" Margin="0,10,0,12">
          <StackPanel>
            <TextBlock Text="{DynamicResource T.HelpHeading}" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBlock Text="{DynamicResource T.Gestures}" TextWrapping="Wrap" Foreground="#B9C1C2"/>
            <TextBlock x:Name="Shortcuts" TextWrapping="Wrap" Foreground="#D5B277" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>
        <TextBlock x:Name="Diagnostics" TextWrapping="Wrap" Foreground="#A9B0B2" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,12"/>
        <TextBlock Text="{DynamicResource T.DesktopHelp}" TextWrapping="Wrap" Foreground="#A9B0B2" Margin="0,0,0,12"/>
      </StackPanel>
    </ScrollViewer>
    <Grid Grid.Row="2" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock x:Name="SaveError" Grid.ColumnSpan="2" TextWrapping="Wrap" Foreground="#FFBC9A" AutomationProperties.LiveSetting="Assertive" Margin="0,0,0,8"/>
      <Button Grid.Row="1" Content="{DynamicResource T.Hide}" Click="HideRug" HorizontalAlignment="Left" Background="#303A3D" Foreground="#F0E8DD"/>
      <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal"><ProgressBar x:Name="SaveProgress" Width="28" Height="4" IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,12,0" AutomationProperties.Name="{DynamicResource T.SavingAccessible}"/><Button x:Name="CancelButton" Content="{DynamicResource T.Cancel}" Click="Cancel" Background="#303A3D" Foreground="#F0E8DD"/><Button x:Name="ApplyButton" Content="{DynamicResource T.Save}" Click="Apply" Margin="0"/></StackPanel>
    </Grid>
  </Grid>
</Window>
